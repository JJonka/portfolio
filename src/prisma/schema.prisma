generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id        Int      @id @default(autoincrement())
  name      String
  headline  String?
  bio       String?
  location  String?
  avatarUrl String?
  createdAt DateTime @default(now())
  email     String?
  linkedIn  String?
  github    String?
}

model Experience {
  id           Int       @id @default(autoincrement())
  company      String
  role         String
  startDate    DateTime
  endDate      DateTime?
  description  String?
  technologies String?   @default("")
  imageUrl     String?
  orderIndex   Int       @default(0)
}

model Recommendation {
  id            Int       @id @default(autoincrement())
  authorName    String
  authorRole    String?
  authorCompany String?
  text          String
  date          DateTime?
  linkedinUrl   String?
}

model Message {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
  read      Boolean  @default(false)
}